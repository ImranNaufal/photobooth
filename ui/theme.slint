export global Theme {
    out property <color> background: #0f172a;
    out property <color> surface: #1e293b;
    out property <color> surface_light: #334155;
    out property <color> border: #334155;
    out property <color> border_highlight: #475569;
    
    out property <brush> primary_gradient: @linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
    out property <brush> primary_hover_gradient: @linear-gradient(135deg, #4f46e5 0%, #db2777 100%);
    out property <brush> dark_glass_gradient: @linear-gradient(180deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.92) 100%);
    
    out property <color> primary: #6366f1;
    out property <color> primary_hover: #4f46e5;
    out property <color> accent_pink: #ec4899;
    
    out property <color> text_primary: #f8fafc;
    out property <color> text_secondary: #94a3b8;
    out property <color> text_muted: #64748b;
    
    out property <color> success: #10b981;
    out property <color> error: #ef4444;
    out property <color> warning: #f59e0b;
    
    out property <length> radius_sm: 8px;
    out property <length> radius_md: 16px;
    out property <length> radius_lg: 24px;
    out property <length> radius_pill: 9999px;
}

