export component FlashOverlay {
    in property <bool> active: false;

    width: 100%;
    height: 100%;

    flash_rect := Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;
        opacity: root.active ? 0.95 : 0.0;

        animate opacity {
            duration: 300ms;
            easing: ease-out;
        }
    }
}

