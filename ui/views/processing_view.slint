import { Theme } from "../theme.slint";

export component ProcessingView {
    in property <string> status_message: "Creating your high-res photo composite...";

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        VerticalLayout {
            alignment: center;
            spacing: 32px;

            // Animated Spinner Ring
            HorizontalLayout {
                alignment: center;
                spinner_container := Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: 60px;
                    border-width: 8px;
                    border-color: #334155;

                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: 60px;
                        border-width: 8px;
                        border-color: Theme.primary;
                        clip: true;
                    }
                }
            }

            // Headline
            Text {
                text: "✨ Processing Magic...";
                color: Theme.text_primary;
                font-size: 38px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            // Subtitle / Status message
            Text {
                text: root.status_message != "" ? root.status_message : "Cropping, aligning, and rendering 300 DPI print layout...";
                color: Theme.text_secondary;
                font-size: 18px;
                horizontal-alignment: center;
            }

            // Progress bar simulation
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 480px;
                    height: 8px;
                    border-radius: 4px;
                    background: #1e293b;

                    Rectangle {
                        x: 0px;
                        width: 320px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.primary_gradient;
                    }
                }
            }
        }
    }
}

