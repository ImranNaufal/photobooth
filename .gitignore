# Rust build artifacts
/target/

# Release and distribution builds (track version metadata, ignore large binaries)
/dist/*
!/dist/version.json

# Generated SQLite runtime database
booth_sessions.db*

# Generated application runtime outputs (keep directory structure)
/output/raw/*
/output/composites/*
/output/mock_prints/*
!/output/raw/.gitkeep
!/output/composites/.gitkeep
!/output/mock_prints/.gitkeep

# Runtime logs
/logs/

# User-specific runtime config
config.json

# Windows temporary files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
